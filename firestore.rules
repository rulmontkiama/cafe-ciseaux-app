rules_version = '2';

// Règles de sécurité Firestore — Café-Ciseaux
//
// PRÉREQUIS : le document de la collection `admin` d'un administrateur doit avoir
// pour ID son UID Firebase Auth (admin/<UID>), avec le champ { admin_id: "<UID>" }.
// Les règles ne peuvent pas chercher un document par valeur de champ ; c'est l'ID
// du document qui sert à reconnaître un admin. Voir FIREBASE_SETUP.md §4.2.
//
// Tout ce qui n'est pas explicitement autorisé ci-dessous est refusé.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Champs modifiés entre l'ancienne et la nouvelle version du document
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- admin ----------
    // Lecture : l'app liste la collection après connexion pour connaître les admins.
    // Écriture : uniquement depuis la console Firebase (jamais depuis l'app).
    match /admin/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- users ----------
    // Un utilisateur lit son propre profil ; un admin lit tous les profils ;
    // tout utilisateur connecté peut lire le profil d'un admin (messagerie).
    match /users/{userId} {
      allow read: if isOwner(resource.data.uid)
        || isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/admin/$(resource.data.uid)));

      // Création de son propre profil à l'inscription (compteur de ciseaux à 0).
      allow create: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.uid == userId
            && request.resource.data.scissor == 0);

      // Mise à jour : uid et email non modifiables ; compteur de ciseaux de 0 à 5 ;
      // jetons push (fcmTokens) limités à 10 appareils par compte.
      allow update: if isAdmin()
        || (isOwner(userId)
            && !changedKeys().hasAny(['uid', 'email'])
            && request.resource.data.scissor is number
            && request.resource.data.scissor >= 0
            && request.resource.data.scissor <= 5
            && (!('fcmTokens' in request.resource.data)
                || (request.resource.data.fcmTokens is list
                    && request.resource.data.fcmTokens.size() <= 10)));

      // Suppression de son propre compte (AuthenticationService.deleteAccount).
      allow delete: if isAdmin() || isOwner(userId);
    }

    // ---------- rendez_vous ----------
    // L'ID du document est l'heure du rendez-vous en millisecondes (UTC) : Firestore refuse de
    // créer deux fois le même ID, donc deux clients ne peuvent plus prendre le même créneau.
    // Un client ne lit que ses propres rendez-vous ; l'admin lit tout. Les créneaux pris,
    // visibles de tous pour être grisés, sont dans la collection `slots` (sans données personnelles).
    // Un rendez-vous et son créneau sont toujours écrits ensemble (même batch).
    function rdvIdMatchesDate(id) {
      return id == string(request.resource.data.date.toMillis());
    }

    // Jour bloqué (congés, fermeture) : le document blocked_days/<AAAA-MM-JJ> existe.
    // Les règles ne connaissent pas l'heure de Paris : le jour est lu en UTC. C'est le même jour
    // que celui de Paris pour tous les créneaux entre 02h59 et 23h59 à Paris, donc pour tout salon
    // ouvert en journée (un créneau à 00h30 ou 01h30 à Paris serait contrôlé sur la veille).
    function utcDayKey(d) {
      return string(d.year()) + '-'
        + (d.month() < 10 ? '0' : '') + string(d.month()) + '-'
        + (d.day() < 10 ? '0' : '') + string(d.day());
    }

    function dayIsOpen(d) {
      return !exists(/databases/$(database)/documents/blocked_days/$(utcDayKey(d)));
    }

    match /rendez_vous/{rdvId} {
      allow read: if isAdmin() || isOwner(resource.data.user_id);

      allow create: if isAdmin()
        || (isOwner(request.resource.data.user_id)
            && request.resource.data.keys().hasOnly(
                 ['date', 'type', 'user_id', 'nom', 'prenom', 'scissor', 'avatar'])
            && request.resource.data.keys().hasAll(
                 ['date', 'type', 'user_id', 'nom', 'prenom', 'scissor'])
            && request.resource.data.date is timestamp
            && request.resource.data.date > request.time
            && rdvIdMatchesDate(rdvId)
            && dayIsOpen(request.resource.data.date)
            && existsAfter(/databases/$(database)/documents/slots/$(rdvId))
            && request.resource.data.type is string
            && request.resource.data.scissor is number);

      // Le propriétaire ne peut modifier que le compteur et l'avatar de ses rendez-vous.
      allow update: if isAdmin()
        || (isOwner(resource.data.user_id)
            && changedKeys().hasOnly(['scissor', 'avatar']));

      allow delete: if isAdmin() || isOwner(resource.data.user_id);
    }

    // ---------- slots (créneaux pris) ----------
    // Seulement la date : aucun nom, prénom ni avatar. Lisible par tout utilisateur connecté.
    match /slots/{slotId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['date'])
            && request.resource.data.date is timestamp
            && request.resource.data.date > request.time
            && slotId == string(request.resource.data.date.toMillis())
            && dayIsOpen(request.resource.data.date)
            && existsAfter(/databases/$(database)/documents/rendez_vous/$(slotId))
            && getAfter(/databases/$(database)/documents/rendez_vous/$(slotId)).data.user_id
                 == request.auth.uid);

      allow update: if false;

      // Libéré par le propriétaire du rendez-vous correspondant (ou l'admin).
      allow delete: if isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/rendez_vous/$(slotId))
            && get(/databases/$(database)/documents/rendez_vous/$(slotId)).data.user_id
                 == request.auth.uid);
    }

    // ---------- horaires ----------
    // Horaires d'ouverture affichés sur le site, y compris aux visiteurs non connectés.
    match /horaires/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- blocked_days ----------
    // Lecture publique (aucune donnée personnelle) pour afficher les fermetures exceptionnelles
    // dès l'accueil et la fenêtre Horaires & Infos, même sans être connecté.
    match /blocked_days/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- beer-selection ----------
    // Sélection de bières affichée publiquement.
    match /beer-selection/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- messages ----------
    // Seuls l'expéditeur et le destinataire lisent un message (admins compris :
    // un admin ne voit que les messages qui lui sont adressés ou qu'il a envoyés).
    match /messages/{msgId} {
      allow read: if isSignedIn()
        && (resource.data.from_id == request.auth.uid
            || resource.data.to_id == request.auth.uid);

      allow create: if isOwner(request.resource.data.from_id)
        && request.resource.data.to_id is string
        && request.resource.data.msg is string
        && request.resource.data.msg.size() > 0
        && request.resource.data.msg.size() <= 2000
        && request.resource.data.is_read == false;

      // Le destinataire peut seulement marquer un message comme lu.
      allow update: if isOwner(resource.data.to_id)
        && changedKeys().hasOnly(['is_read'])
        && request.resource.data.is_read == true;

      // Suppression autorisée pour l'admin (nettoyage de conversation) ou pour les participants
      // uniquement lorsque le message temporaire a expiré (expiresAt <= request.time).
      allow delete: if isAdmin()
        || (isSignedIn()
            && (resource.data.from_id == request.auth.uid
                || resource.data.to_id == request.auth.uid)
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt <= request.time);
    }

    // ---------- demo ----------
    match /demo/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
